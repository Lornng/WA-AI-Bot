# ── Bot service ────────────────────────────────────────────────────────────
PORT=3010
BOT_NAME=Wally
BOT_PREFIX=!
# Your number, digits only, no +/spaces. This number is always allowed (owner).
OWNER_NUMBER=61400000000
# Extra numbers allowed to DM the bot, comma-separated, digits only.
ALLOWED_NUMBERS=
# Where SQLite data is stored
DATA_DIR=./data
# Messages older than this are ignored (reconnect replays). Minutes.
STALE_AFTER_MIN=2
# Rate limit per (chat, sender)
RATE_MAX=10
RATE_WINDOW_MS=30000
# How many past messages of a chat feed the AI context
HISTORY_TURNS=20

# ── Evolution API gateway ──────────────────────────────────────────────────
# Inside docker-compose the host is "evolution"; locally, use http://localhost:3000
EVOLUTION_URL=http://evolution:3000
EVOLUTION_API_KEY=change-me-a-long-random-string
EVOLUTION_INSTANCE=default
# Used only if the bot has to create the instance at startup
EVOLUTION_INSTANCE_TOKEN=

# ── Anthropic / Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Jira (cloud) ───────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=***
JIRA_DEFAULT_PROJECT=WA
JIRA_DEFAULT_ISSUE_TYPE=Task
